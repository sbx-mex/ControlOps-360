  "date": "2026-09-14",
  "release": "integracion-360-estable",
  "update_policy": {
    "replacement": "atomic",
    "python_gate": "scripts/auditar_proyecto.py",
    "zip_builder": "scripts/crear_zip_seguro.py",
    "operational_files_allowed": false
  },
  "capabilities": [
    "maxmin",
    "trend",
    "order_woe",
    "peak_hour",
    "normalizados",
    "assembly",
    "baking",
    "top_products",
    "operational_effort",
    "void_audit"
  ],
  "security": [
    "local_processing",
    "strict_csp",
    "pinned_actions",
    "hashed_python_dependencies",
    "bounded_inputs",
    "manifested_zip"
  ],
  "validation": [
    "python -m unittest discover -s tests -v",
    "python scripts/auditar_proyecto.py --json",
    "node --test tests/*.test.mjs",
    "python scripts/crear_zip_seguro.py <salida.zip>",
    "python scripts/auditar_proyecto.py --zip <salida.zip> --json"
  ]
}
